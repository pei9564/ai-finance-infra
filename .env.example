# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit secrets.
#
# 這份 .env 是「整套系統的單一設定來源」。standalone 部署 (沒有 clone 其他
# repo 時) 完全靠這份。本機開發 (有 clone 其他 repo + 套 docker-compose.dev.yml)
# 時主要設定也都在這,sibling repo 的 .env 已不再被讀取。

# ─── Required ──────────────────────────────────────────────────

# PostgreSQL (整個系統的統一資料層)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_db

# scraper 需要的 GitHub PAT (read:packages + repo 讀取)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Container image (private GHCR;規劃遷移至 self-hosted Harbor)
# 第一次拉之前先 docker login ghcr.io
SCRAPER_IMAGE=ghcr.io/pei9564/finance-scraper-service:latest
STT_IMAGE=ghcr.io/pei9564/stt-ai-worker:latest

# ─── Optional: scraper ─────────────────────────────────────────

# SCRAPER_PORT=8080
# VLLM_BASE_URL=http://host.docker.internal:8000/v1  # 預設打 host 上的 vLLM gateway
# VLLM_MODEL=
# VLLM_API_KEY=
# LOOKBACK_DAYS=7
# STT_BASE_URL=http://stt-ai-worker:8000             # compose 內部 DNS,通常不用改

# ─── Optional: STT (faster-whisper) ────────────────────────────

# 模型大小: tiny / base / small / medium / large-v3
# STT_MODEL=medium

# 執行裝置: cuda (GPU,需 NVIDIA Container Toolkit) / cpu
# STT_DEVICE=cuda

# 量化精度: GPU 建議 int8 (省 VRAM) 或 float16; CPU 用 int8
# STT_COMPUTE_TYPE=int8

# 批次大小: 1 不批次最省電 / 4 平衡 / 8 最快
# STT_BATCH_SIZE=4

# 語言: 留空=自動偵測 / zh / en (指定可加快並提升準確度)
# STT_LANGUAGE=zh

# ─── Optional: Host paths ──────────────────────────────────────

# HuggingFace 模型 cache (避免每次重啟都重下載權重)
# 預設 ./hf_cache (compose 檔旁邊),也可指向系統共用的 cache
# HF_CACHE_DIR=/path/to/huggingface/cache

# host 上的 docker config (要拉 private GHCR image 才需要)
# 預設 ~/.docker/config.json,先 `docker login ghcr.io` 過就會有
# DOCKER_CONFIG_PATH=~/.docker/config.json
