# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit secrets.

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_db

# --- MinIO ---
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=change-me

# --- Image tags (Repo 1 / Repo 2) ---
# main 分支自動 push :latest 到 GHCR；要 pin 版本可改成 :sha-xxxxxxx 或 :v1.2.3
# Image 是 private,第一次拉之前要先在這台機器登入:
#   echo <PAT_with_read:packages> | docker login ghcr.io -u pei9564 --password-stdin
SCRAPER_IMAGE=ghcr.io/pei9564/finance-scraper-service:latest
STT_IMAGE=ghcr.io/pei9564/stt-ai-worker:latest

# --- Optional overrides (都有 default,不設也能跑) ---
# SCRAPER_PORT=8080
# VLLM_BASE_URL=http://host.docker.internal:8000/v1  # 真正的值通常放在 ../finance-scraper-service/.env

# --- Host paths (default 可跑,但建議按環境調整) ---
# HF_CACHE_DIR: HuggingFace 模型 cache 路徑 (避免每次重啟都重下載 model weights)
# 預設 ./hf_cache (compose 檔旁邊),也可以指向系統共用的 cache
# HF_CACHE_DIR=/path/to/huggingface/cache

# DOCKER_CONFIG_PATH: host 上的 docker config (要拉 private GHCR image 才需要)
# 預設 ~/.docker/config.json,先 `docker login ghcr.io` 過就會有
# DOCKER_CONFIG_PATH=~/.docker/config.json
