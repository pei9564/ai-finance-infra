# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit secrets.

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_db

# --- MinIO ---
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=change-me

# --- Image tags (Repo 1 / Repo 2) ---
SCRAPER_IMAGE=finance-scraper-service:latest
STT_IMAGE=stt-ai-worker:latest

# --- Optional overrides (都有 default,不設也能跑) ---
# SCRAPER_PORT=8080
# VLLM_BASE_URL=http://host.docker.internal:8000/v1  # 真正的值通常放在 ../finance-scraper-service/.env
