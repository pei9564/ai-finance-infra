# ============================================================
# secrets.yaml.example — 範本檔，不含真實值
# ============================================================
# 使用方式：
#   cp k8s/secrets.yaml.example k8s/secrets.yaml
#   編輯 k8s/secrets.yaml 填入真實值
#   sudo k3s kubectl apply -f k8s/secrets.yaml
#
# GHCR image pull credential 建議用指令建立（不用手動 base64）：
#   sudo k3s kubectl create secret docker-registry ghcr-cred \
#     --docker-server=ghcr.io \
#     --docker-username=pei9564 \
#     --docker-password=<YOUR_GHCR_PAT> \
#     -n finance
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: finance
type: Opaque
stringData:
  POSTGRES_USER: "admin"
  POSTGRES_PASSWORD: "change-me"
  POSTGRES_DB: "finance_db"
  GITHUB_TOKEN: "ghp_xxxxxxxxxxxxxxxxxxxx"
  # VLLM_API_KEY: ""
